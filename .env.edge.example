# ── Restaurant OS — EDGE hub environment ────────────────────────────────────
# Copy to `.env.edge` and fill in. Used by docker-compose.edge.yml.
# Validated at boot (zod, fail-fast): in EDGE the four EDGE_* ids are REQUIRED.

# Runtime mode — this file is for an edge hub.
APP_MODE=EDGE
NODE_ENV=production
PORT=3001

# ── Published image (EDGE-PKG-1) ────────────────────────────────────────────
# Which GHCR tag docker-compose.edge.yml PULLS. Pin to a known-good release so
# "download compose + run" is reproducible; leave unset to track `latest`.
# To update: bump this, then `docker compose ... pull && ... up -d`.
EDGE_IMAGE_TAG=edge-v0.1.0

# ── Edge identity ───────────────────────────────────────────────────────────
# The ONE org -> restaurant -> branch this hub serves, plus a stable node id.
# In production these come from cloud provisioning (OFF-2). For a standalone
# smoke test, pick stable ids and run with EDGE_SEED=true (see below) so rows
# with these exact ids exist locally.
EDGE_ORG_ID=edge-org-0001
EDGE_RESTAURANT_ID=edge-restaurant-0001
EDGE_BRANCH_ID=edge-branch-0001
EDGE_NODE_ID=edge-node-kitchen-01

# ── Local database ──────────────────────────────────────────────────────────
# These feed both the Postgres container and DATABASE_URL (compose builds the
# URL from them). Override the URL directly if you point at an external DB.
EDGE_DB_USER=restaurantos
EDGE_DB_PASSWORD=restaurantos
EDGE_DB_NAME=restaurantos

# ── Auth secrets ────────────────────────────────────────────────────────────
# Tenant secrets sign tokens for this restaurant's users (min 16 chars).
JWT_ACCESS_SECRET=change-me-edge-access-secret-min16
JWT_REFRESH_SECRET=change-me-edge-refresh-secret-min16
# Platform secrets are unused on edge (platform module is excluded) but still
# validated — leave the placeholders or set your own (min 16 chars).
PLATFORM_JWT_ACCESS_SECRET=edge-unused-platform-access-secret
PLATFORM_JWT_REFRESH_SECRET=edge-unused-platform-refresh-secret
# Consumer (customer) auth secrets — REQUIRED by env validation (CX-2). The hub
# will NOT boot without them, even in setup mode. Set real per-hub values (min 16
# chars) if the edge serves customer-facing ordering.
CONSUMER_JWT_ACCESS_SECRET=change-me-edge-consumer-access-min16
CONSUMER_JWT_REFRESH_SECRET=change-me-edge-consumer-refresh-min16

# ── Pairing (OFF-2) ─────────────────────────────────────────────────────────
# The cloud base URL + this node's bearer token (from POST /edge-nodes). On
# first boot with an UNSEEDED local DB, the hub pulls its branch snapshot from
# {CLOUD_URL}/edge/snapshot and applies it (mirroring cloud ids). Leave blank to
# run a fully offline/seed-only hub. After bootstrap the hub runs offline; use
# POST /edge/resync to re-pull on demand.
CLOUD_URL=https://cloud.example.com
EDGE_NODE_TOKEN=

# Config sync (OFF-3): how often the hub pulls cloud→edge config (catalog, users,
# settings). Min 30000ms; default 120000 (2 min). Also runs on reconnect.
CONFIG_SYNC_INTERVAL_MS=120000

# Fiscal config on the hub (FISCAL-EDGE-1). The branch FiscalConfig (+ physical-HDM
# device) syncs down envelope-ENCRYPTED and the hub decrypts LOCALLY. To read those
# synced rows the hub must run the DB backend. When FISCAL_CONFIG_BACKEND=DB these
# two are REQUIRED and boot-validated:
#   - FISCAL_MASTER_KEK: 64-hex (32 bytes). MUST match the cloud's KEK byte-for-byte
#     or decryption fails closed (no plaintext). Provisioned per hub (self-install).
#   - FISCAL_SRC_CA_PATH: path to the shared SRC public CA (PEM). Non-secret.
# Leave FISCAL_CONFIG_BACKEND=FILE (default) to ignore synced rows and use the
# on-disk FISCAL_CONFIG_PATH JSON instead (no decrypted device config then).
FISCAL_CONFIG_BACKEND=FILE
# FISCAL_MASTER_KEK=
# FISCAL_SRC_CA_PATH=/etc/restaurant-os/src-ca.pem

# Operational push (OFF-4): how often the hub drains its operational outbox
# edge→cloud (orders, payments, stock, KDS, reservations). Min 5000ms; default
# 30000 (30s). Also runnable on demand via POST /edge/push-now.
EDGE_PUSH_INTERVAL_MS=30000

# Heartbeat (OFF-8): how often the hub reports telemetry + its app/schema version
# to the cloud. Clamped to 30000–60000ms; default 45000 (45s). The reply tells
# the hub whether its schema is compatible; on a mismatch the hub PAUSES sync
# (keeps serving locally) and shows "update required" until updated.
EDGE_HEARTBEAT_INTERVAL_MS=45000

# Schema-version REPORT override (OFF-8) — TESTING ONLY. Leave UNSET in
# production so the hub reports its built-in SCHEMA_VERSION. Set it to a value
# the cloud does NOT expect to force a SCHEMA_MISMATCH (sync pauses) and verify
# the update flow. The cloud is always authoritative.
# EDGE_SCHEMA_VERSION=

# NOTE: EDGE_OFFLINE_THRESHOLD_MS is a CLOUD-side setting (how long the cloud
# waits for a heartbeat before showing a node OFFLINE; default 180000ms). It is
# set on the cloud deployment, not on the hub.

# ── Object storage (MEDIA-1) ────────────────────────────────────────────────
# The edge hub serves media LOCALLY (dev driver) so it holds NO storage secrets.
# Uploads persist on the edge_data volume (/data/media) across updates. EDGE is
# exempt from the dev-driver-in-production guard (see env.schema.ts). Point
# STORAGE_PUBLIC_BASE_URL at the hub's own LAN base if clients aren't same-origin.
STORAGE_DRIVER=dev
MEDIA_DEV_DIR=/data/media
STORAGE_PUBLIC_BASE_URL=http://localhost:3001

# ── Misc ────────────────────────────────────────────────────────────────────
# LAN clients are typically same-origin behind the hub; "*" is fine for a node.
CORS_ORIGINS=*
PLATFORM_ROOT_DOMAIN=edge.local

# Reverse-proxy hops (3A/3B). The hub sits behind its own LAN Nginx, so trust one
# proxy hop and read the real LAN client IP from X-Forwarded-For — branch IP
# policy (STRICT/SOFT) depends on this being correct. Set higher if you add more
# proxies in front of the API.
TRUST_PROXY=1

# Device-anchored PIN lockout (3A/3B) — per-user, enforced LOCALLY at the edge
# while offline. Keep identical to the cloud so behavior matches online/offline.
PIN_MAX_ATTEMPTS=500
PIN_LOCKOUT_MINUTES=1

# ── Temporary smoke seed (OFF-1, superseded by OFF-2 snapshot) ───────────────
# Leave FALSE in the normal OFF-2 flow — the cloud snapshot bootstrap populates
# the branch. Only set true to smoke-test a hub with NO cloud (no CLOUD_URL).
EDGE_SEED=false
EDGE_SEED_OWNER_EMAIL=owner@edge.local
EDGE_SEED_OWNER_PASSWORD=ChangeMe123!
